@model IEnumerable<RestaurantInventory.Models.ProductoCatalogoViewModel>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Catálogo de Productos</h2>
        <a asp-action="Create" class="btn btn-success">+ Nuevo Producto</a>
    </div>
    <hr />

    <!-- AÑADIMOS text-center Y align-middle AQUÍ -->
    <table class="table table-striped table-hover text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Disponible</th>
                <th>Cantidad Óptima</th>
                <th>Punto de Reorden</th>
                <th>Tipo Monitoreo</th>
                <th>Expiración</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">No hay productos en la base de datos todavía.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.Nombre</strong></td>
                        <td class="fw-bold fs-5 text-primary">@item.CantidadActual</td>
                        <td>@item.CantidadOptima</td>
                        <td>@item.PuntoReorden</td>
                        <td>@(item.TipoMonitoreo == 1 ? "Cámara + Peso" : "Solo Peso")</td>
                        
                        <td class="fw-bold @(item.FechaExpiracion.HasValue && item.FechaExpiracion.Value <= DateTime.Now.AddDays(3) ? "text-danger" : "text-success")">
                            @(item.FechaExpiracion.HasValue ? item.FechaExpiracion.Value.ToString("dd/MM/yyyy") : "N/A")
                        </td>

                        <td>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>